# Phase 1 구성. 실제 값은 .env 에 두고 Git에 올리지 않는다.

# Hugging Face 모델 ID
LOCAL_AI_CAD_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct

# 추론 장치. Phase 1 실측은 cuda 필수. cpu 는 진단 목적으로만 허용한다.
LOCAL_AI_CAD_DEVICE=cuda

# 가중치 dtype. RTX 4060 기준선은 float16.
LOCAL_AI_CAD_DTYPE=float16

# 무제한 생성 방지
LOCAL_AI_CAD_MAX_NEW_TOKENS=512

# Hugging Face 캐시 경로. C: 여유 공간이 부족하면 다른 드라이브를 지정한다.
# LOCAL_AI_CAD_HF_HOME=D:/hf-cache

# 사진 3D용 별도 로컬 Hunyuan3D shape 서버
LOCAL_AI_CAD_HUNYUAN_URL=http://127.0.0.1:8090

# 애플리케이션 로그 수준
LOCAL_AI_CAD_LOG_LEVEL=INFO
